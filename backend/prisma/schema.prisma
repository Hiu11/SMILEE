generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum Role {
  ADMIN
  RECEPTIONIST
  DOCTOR
  CUSTOMER
}

enum AppointmentStatus {
  PENDING    // Khách hàng mới đặt
  CONFIRMED  // Lễ tân đã xác nhận
  COMPLETED  // Đã khám xong
  CANCELLED  // Bị hủy
}

enum InvoiceStatus {
  UNPAID
  PAID
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

// 1. TÀI KHOẢN NGƯỜI DÙNG
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String?
  avatar    String?
  role      Role     @default(CUSTOMER)
  
  otp        String?
  otpExpires DateTime?
  isVerified Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan hệ
  appointmentsAsCustomer Appointment[] @relation("CustomerAppointments")
  appointmentsAsDoctor   Appointment[] @relation("DoctorAppointments")
  medicalRecords         Record[]      @relation("PatientRecords")
  invoices               Invoice[]     @relation("CustomerInvoices")
}

// 2. DỊCH VỤ NHA KHOA
model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  duration    Int      // Thời gian thực hiện ước tính (phút)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Quan hệ
  appointmentServices AppointmentService[]
}

// 3. LỊCH HẸN
model Appointment {
  id          String            @id @default(uuid())
  date        DateTime          // Ngày và giờ hẹn
  status      AppointmentStatus @default(PENDING)
  notes       String?           // Ghi chú của khách hàng

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  customerId  String
  doctorId    String?

  // Quan hệ
  customer    User                 @relation("CustomerAppointments", fields: [customerId], references: [id])
  doctor      User?                @relation("DoctorAppointments", fields: [doctorId], references: [id])
  services    AppointmentService[]
  record      Record?              // 1 Lịch hẹn có thể sinh ra 1 Bệnh án
  invoice     Invoice?             // 1 Lịch hẹn có thể sinh ra 1 Hóa đơn
}

// Bảng trung gian n-n giữa Appointment và Service
model AppointmentService {
  appointmentId String
  serviceId     String
  quantity      Int      @default(1)

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([appointmentId, serviceId])
}

// 4. HỒ SƠ BỆNH ÁN
model Record {
  id            String   @id @default(uuid())
  diagnosis     String   // Chẩn đoán
  treatmentPlan String   // Kế hoạch điều trị
  notes         String?  // Ghi chú thêm của bác sĩ

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign Keys
  patientId     String
  appointmentId String   @unique // Bệnh án được tạo từ lịch hẹn nào

  // Quan hệ
  patient       User        @relation("PatientRecords", fields: [patientId], references: [id])
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

// 5. HÓA ĐƠN
model Invoice {
  id            String        @id @default(uuid())
  totalAmount   Float         // Tổng tiền
  status        InvoiceStatus @default(UNPAID)
  paymentMethod String?       // CASH, CREDIT_CARD, BANK_TRANSFER

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign Keys
  customerId    String
  appointmentId String?       @unique // Hóa đơn cho lịch hẹn nào

  // Quan hệ
  customer      User         @relation("CustomerInvoices", fields: [customerId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

// 6. KHO VẬT TƯ (WAREHOUSE)
model WarehouseItem {
  id          String   @id @default(uuid())
  name        String
  category    String   // Loại vật tư: Thuốc, Thiết bị y tế, Dụng cụ
  quantity    Int      @default(0)
  unit        String   // Đơn vị (Hộp, Cái, Vỉ...)
  pricePerUnit Float

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  email     String?
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 7. QUẢN LÝ ĐIỀU TRỊ (TREATMENT)
model Treatment {
  id          String    @id @default(uuid())
  patientName String
  doctorName  String
  toothArea   String
  procedure   String
  status      String
  nextVisit   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
